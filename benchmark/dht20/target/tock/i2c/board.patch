+// SPDX-License-Identifier: Apache-2.0
+//! Public DHT20 resource/client wiring; no sensor protocol or arithmetic.
+use capsules_core::virtualizers::virtual_alarm::{MuxAlarm,VirtualMuxAlarm};
+use capsules_core::virtualizers::virtual_i2c::{I2CDevice,MuxI2C};
+use capsules_extra::dht20::Dht20;
+use core::mem::MaybeUninit;
+use kernel::component::Component;
+use kernel::hil::{i2c,time};
+use kernel::hil::time::Alarm;
+#[macro_export]
+macro_rules! dht20_component_static {
+    ($A:ty,$I:ty $(,)?)=>{{
+        let alarm=kernel::static_buf!(capsules_core::virtualizers::virtual_alarm::VirtualMuxAlarm<'static,$A>);
+        let device=kernel::static_buf!(capsules_core::virtualizers::virtual_i2c::I2CDevice<'static,$I>);
+        let buffer=kernel::static_buf!([u8;7]);
+        let sensor=kernel::static_buf!(capsules_extra::dht20::Dht20<'static,
+            capsules_core::virtualizers::virtual_i2c::I2CDevice<'static,$I>,
+            capsules_core::virtualizers::virtual_alarm::VirtualMuxAlarm<'static,$A>>);
+        (alarm,device,buffer,sensor)
+    }};
+}
+pub struct Dht20Component<A:'static+time::Alarm<'static>,I:'static+i2c::I2CMaster<'static>> {
+    i2c:&'static MuxI2C<'static,I>,alarm:&'static MuxAlarm<'static,A>,address:u8,
+}
+impl<A:'static+time::Alarm<'static>,I:'static+i2c::I2CMaster<'static>> Dht20Component<A,I> {
+    pub fn new(i2c:&'static MuxI2C<'static,I>,alarm:&'static MuxAlarm<'static,A>,address:u8)->Self {
+        Self{i2c,alarm,address}
+    }
+}
+impl<A:'static+time::Alarm<'static>,I:'static+i2c::I2CMaster<'static>> Component for Dht20Component<A,I> {
+    type StaticInput=(&'static mut MaybeUninit<VirtualMuxAlarm<'static,A>>,
+        &'static mut MaybeUninit<I2CDevice<'static,I>>,&'static mut MaybeUninit<[u8;7]>,
+        &'static mut MaybeUninit<Dht20<'static,I2CDevice<'static,I>,VirtualMuxAlarm<'static,A>>>);
+    type Output=&'static Dht20<'static,I2CDevice<'static,I>,VirtualMuxAlarm<'static,A>>;
+    fn finalize(self,s:Self::StaticInput)->Self::Output {
+        let alarm=s.0.write(VirtualMuxAlarm::new(self.alarm));alarm.setup();
+        let device=s.1.write(I2CDevice::new(self.i2c,self.address));let buffer=s.2.write([0;7]);
+        let sensor=s.3.write(Dht20::new(device,alarm,buffer));
+        device.set_client(sensor);alarm.set_alarm_client(sensor);let _=sensor.startup();sensor
+    }
+}
