{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "autodriver.method-request/v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "condition": {
      "enum": [
        "S",
        "D",
        "SD"
      ]
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "enum": [
        "offline_contract",
        "run"
      ]
    },
    "model": {},
    "budget": {},
    "repetition": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema",
    "task_id",
    "condition",
    "workspace",
    "operation"
  ],
  "additionalProperties": false
}
