+// Licensed under the Apache License, Version 2.0 or the MIT License.
+// Resource wiring follows Tock Contributors' SPI and alarm components.
+//! Public resources and clients only; no sensor protocol or conversion logic.
+use capsules_core::virtualizers::virtual_alarm::{MuxAlarm, VirtualMuxAlarm};
+use capsules_core::virtualizers::virtual_spi::{MuxSpiMaster, VirtualSpiMasterDevice};
+use capsules_extra::adt7310::Adt7310;
+use core::mem::MaybeUninit;
+use kernel::component::Component;
+use kernel::hil::spi::{self, SpiMasterDevice};
+use kernel::hil::time::{self, Alarm};
+#[macro_export]
+macro_rules! adt7310_component_static {
+    ($A:ty, $S:ty $(,)?) => {{
+        let alarm = kernel::static_buf!(capsules_core::virtualizers::virtual_alarm::VirtualMuxAlarm<'static,$A>);
+        let spi = kernel::static_buf!(capsules_core::virtualizers::virtual_spi::VirtualSpiMasterDevice<'static,$S>);
+        let tx = kernel::static_buf!([u8;16]);
+        let rx = kernel::static_buf!([u8;16]);
+        let driver = kernel::static_buf!(capsules_extra::adt7310::Adt7310<'static,
+            capsules_core::virtualizers::virtual_spi::VirtualSpiMasterDevice<'static,$S>,
+            capsules_core::virtualizers::virtual_alarm::VirtualMuxAlarm<'static,$A>>);
+        (alarm,spi,tx,rx,driver)
+    }};
+}
+pub struct Adt7310Component<A: 'static + time::Alarm<'static>, S: 'static + spi::SpiMaster<'static>> {
+    spi_mux: &'static MuxSpiMaster<'static,S>, alarm_mux: &'static MuxAlarm<'static,A>, chip_select: S::ChipSelect,
+}
+impl<A: 'static + time::Alarm<'static>, S: 'static + spi::SpiMaster<'static>> Adt7310Component<A,S> {
+    pub fn new(spi_mux: &'static MuxSpiMaster<'static,S>, alarm_mux: &'static MuxAlarm<'static,A>, chip_select: S::ChipSelect) -> Self {
+        Self {spi_mux,alarm_mux,chip_select}
+    }
+}
+impl<A: 'static + time::Alarm<'static>, S: 'static + spi::SpiMaster<'static>> Component for Adt7310Component<A,S> {
+    type StaticInput = (&'static mut MaybeUninit<VirtualMuxAlarm<'static,A>>,
+        &'static mut MaybeUninit<VirtualSpiMasterDevice<'static,S>>, &'static mut MaybeUninit<[u8;16]>,
+        &'static mut MaybeUninit<[u8;16]>, &'static mut MaybeUninit<Adt7310<'static,VirtualSpiMasterDevice<'static,S>,VirtualMuxAlarm<'static,A>>>);
+    type Output = &'static Adt7310<'static,VirtualSpiMasterDevice<'static,S>,VirtualMuxAlarm<'static,A>>;
+    fn finalize(self,s:Self::StaticInput)->Self::Output {
+        let alarm=s.0.write(VirtualMuxAlarm::new(self.alarm_mux)); alarm.setup();
+        let spi=s.1.write(VirtualSpiMasterDevice::new(self.spi_mux,self.chip_select)); spi.setup();
+        let driver=s.4.write(Adt7310::new(spi,alarm,s.2.write([0;16]),s.3.write([0;16])));
+        spi.set_client(driver); alarm.set_alarm_client(driver);
+        let _=driver.startup(); driver
+    }
+}
