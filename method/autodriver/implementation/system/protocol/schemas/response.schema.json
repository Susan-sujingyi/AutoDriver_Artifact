{
  "type": "object",
  "properties": {
    "schema": {
      "const": "autodriver.llm-response/v0.1"
    },
    "call_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "stage": {
      "enum": [
        "fp_build",
        "dbc_recover",
        "bp_build",
        "code_generate",
        "repair"
      ]
    },
    "outcome": {
      "enum": [
        "candidate",
        "needs_evidence",
        "blocked"
      ]
    },
    "artifact": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "fp",
                "dbc",
                "bp"
              ]
            },
            "format": {
              "const": "constructor"
            },
            "content": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "format",
            "content"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "fp",
                "dbc",
                "bp"
              ]
            },
            "format": {
              "const": "constructor_tree"
            },
            "content": {
              "type": "object"
            }
          },
          "required": [
            "kind",
            "format",
            "content"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "fp",
                "dbc",
                "bp"
              ]
            },
            "format": {
              "const": "constructor_edits"
            },
            "base_material_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "base_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "edits": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "properties": {
                  "operation": {
                    "enum": [
                      "replace",
                      "add",
                      "append"
                    ]
                  },
                  "path": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "integer",
                          "minimum": 0
                        }
                      ]
                    }
                  },
                  "value": {}
                },
                "required": [
                  "operation",
                  "path",
                  "value"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "kind",
            "format",
            "base_material_id",
            "base_sha256",
            "edits"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "code"
            },
            "format": {
              "const": "file_edits"
            },
            "edits": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "operation": {
                    "enum": [
                      "create",
                      "replace",
                      "delete"
                    ]
                  },
                  "base_sha256": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "content": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "path",
                  "operation",
                  "base_sha256",
                  "content"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "format",
            "edits"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_links": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "material_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "start_line": {
                "type": "integer",
                "minimum": 1
              },
              "end_line": {
                "type": "integer",
                "minimum": 1
              },
              "basis": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "claim",
              "material_id",
              "start_line",
              "end_line",
              "basis"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "type": "string",
                "minLength": 1
              },
              "citations": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "maxItems": 32
              }
            },
            "required": [
              "claim",
              "basis",
              "citations"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 0
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "impact": {
            "enum": [
              "required",
              "optional",
              "unknown"
            ]
          }
        },
        "required": [
          "subject",
          "reason",
          "impact"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "context_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "enum": [
              "source",
              "device_documents",
              "source_framework",
              "target_framework",
              "target_support",
              "method_specification",
              "internal_tools",
              "upstream_stage"
            ]
          },
          "query": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "question",
          "scope",
          "query",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 8
    },
    "change_summary": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema",
    "call_id",
    "stage",
    "outcome",
    "artifact",
    "evidence_links",
    "unresolved",
    "context_requests",
    "change_summary"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
